# Where the PHP API lives.
# Production: leave unset — the export and the API share a domain, so /api works.
# Local: the API runs on its own port, so point at it and allow the origin in
# backend/config/config.php (cors.allowed_origins). Use the SAME hostname for both
# servers (127.0.0.1 here and 127.0.0.1:3000 in the browser) — session cookies are
# SameSite=Lax and won't travel between "localhost" and "127.0.0.1".
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8088/api
